# Copy to .env for local settings. Leave OPID_* unset for account-free loopback use.
# PORT=4317
# FLOW_LOCAL_NAME=Local user
# FLOW_LOCAL_EMAIL=local@example.test

# Optional instance branding. FLOW_LOGO_PATH must point to a file under public/.
# FLOW_INSTANCE_NAME=My Flow
# FLOW_ACCENT_COLOR=#7cb980
# FLOW_LOGO_PATH=/branding/logo.svg

# Hosted sign-in requires all four values and an OneProfileID app registration.
# OPID_BASE_URL=https://your-oneprofileid.example
# OPID_APP_ID=
# OPID_APP_SECRET=
# OPID_APP_ORIGIN=https://flow.example.com
# OWNER_EMAIL=owner@example.com

# Persist these directories on a hosted instance.
# BACKUP_DIR=/data/backups
# SAVES_DIR=/data/saves
# INBOX_DIR=/data/inbox
# DATABASE_URL=
# DATABASE_SSL=1

# Optional invite email. Invites still work without email delivery.
# RESEND_API_KEY=
# FLOW_EMAIL_FROM=Flow <flow@example.com>

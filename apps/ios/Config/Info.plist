<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Plain http only for a Flow server on this Mac or the local network (development). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Widget and notification links: flowapp://inbox, flowapp://card?env=…&id=… -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Flow links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>flowapp</string>
			</array>
		</dict>
	</array>
	<!-- Keeps the widgets current while the app is closed (BackgroundRefresh). -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.flygonlc.flow.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
